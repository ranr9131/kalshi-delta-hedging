[Unit]
Description=NN v2_small multi-bet live shadow (14 features)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/kalshi-delta-hedging
ExecStart=/usr/bin/python3 -u /root/kalshi-delta-hedging/nn/live_shadow_v2_small.py --interval 30
Restart=on-failure
RestartSec=10
StandardOutput=append:/root/kalshi-delta-hedging/nn/shadow_v2_small_runtime.log
StandardError=append:/root/kalshi-delta-hedging/nn/shadow_v2_small_runtime.log

[Install]
WantedBy=multi-user.target
