[Unit]
Description=Kalshi snipe settler (polls market outcomes)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/kalshi-delta-hedging/live
Environment=LOG_PATH=/home/ec2-user/kalshi-delta-hedging/live/snipes.csv
Environment=RESULT_PATH=/home/ec2-user/kalshi-delta-hedging/live/settlements.csv
Environment=POLL_INTERVAL_SEC=3
Environment=SETTLEMENT_DELAY_SEC=5
ExecStart=/usr/bin/python3.11 /home/ec2-user/kalshi-delta-hedging/live/settler.py
StandardOutput=append:/home/ec2-user/kalshi-delta-hedging/live/settler.log
StandardError=append:/home/ec2-user/kalshi-delta-hedging/live/settler.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
