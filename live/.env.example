KALSHI_API_KEY_ID=your-api-key-id-here
KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
your-private-key-here
-----END RSA PRIVATE KEY-----"

# Trading mode: "true" simulates, "false" places real orders
PAPER_MODE=true

# Strategy params
MODE=dh-target          # dh-target | dh-additive
BASE_STAKE=10.0         # dollar stake before f(BTC move) × g(mispricing) sizing
MIN_BET=1               # skip computed bets smaller than this (fee drag)
ACTIVE_HOURS=           # blank = 24/7. Or "13-20" for hours 13:00-20:00 UTC

# Reversal hedge: at each minute ≥ RH_MINUTE, if net contract imbalance is
# ≥ RH_TRIGGER on the wrong side, buy enough of the now-correct side to
# neutralize. Skipped if fill price would exceed MAX_HEDGE_FILL_PRICE (0.80
# hardcoded in trader.py — hedges priced near 1.0 are negative-EV).
RH_MINUTE=10
RH_TRIGGER=1.0

# Per-window dollar wagered cap. Two ways to set, dynamic wins:
#   CAP_FRACTION_OF_BALANCE > 0  ->  cap = balance × this fraction
#   MAX_WINDOW_WAGERED           ->  static fallback if balance fetch fails
CAP_FRACTION_OF_BALANCE=0.33
MAX_WINDOW_WAGERED=30

# Time-decay sizing: stake × 0.4 (T+4-T+6.5), × 0.8 (T+7-T+9.5), × 1.2 (T+10+).
# Sim across 6,275 windows: +6.5pp ROI vs flat sizing, smaller losses on
# choppy windows where early signals reverse. Set false to use flat sizing.
TIME_DECAY=true

# Optional: bootstrap session counter if you restart mid-day
# STARTING_BALANCE=100.0

# ── Market maker config (market_maker.py only — separate from trader.py) ──
# Paper mode logs what it would do without placing orders. Set to false to go live.
MM_PAPER_MODE=true
# Per-quote size in dollars (per leg)
MM_QUOTE_SIZE_DOLLARS=5.0
# How many cents inside top-of-book to post
MM_INSIDE_CENTS=1
# Minimum book spread (cents) to quote into; skip if tighter
MM_MIN_SPREAD_CENTS=3
# Max signed inventory (absolute $) before skewing
MM_MAX_INVENTORY_DOLLARS=30
# Hard cap on total wagered per window
MM_MAX_TOTAL_WAGERED=200
# Stop quoting in the last N minutes of a window
MM_STOP_QUOTING_LAST_MINS=2
# Quote refresh interval (seconds)
MM_REFRESH_SECS=2
