[Unit]
Description=Crypto regime watcher (updates regime.txt every 5 min)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/kalshi-delta-hedging/live
ExecStart=/usr/bin/python3.11 /home/ec2-user/kalshi-delta-hedging/live/regime_watch.py --loop
StandardOutput=append:/home/ec2-user/kalshi-delta-hedging/live/regime_watch.log
StandardError=append:/home/ec2-user/kalshi-delta-hedging/live/regime_watch.log
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
