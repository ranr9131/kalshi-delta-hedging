# ── Secrets — never commit credentials ───────────────────────────────────────
.env
.env.*
!.env.example
live/.env
live/.env.*
!live/.env.example
*.pem
*.key

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.Python
*.egg-info/
dist/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Market-data corpora (huge, regenerated; canonical copy lives on AWS) ─────
recordings/
recordings_fresh/
data/cache/
*.jsonl
*.jsonl.gz

# data/logs is scratch EXCEPT the precomputed table the trader needs at runtime
data/logs/*
!data/logs/minute_analysis_2d.csv

# ── Runtime state, logs, probe output (per-machine, regenerated) ──────────────
*.log
*.out
live/*.csv
nn/replay_*.csv
nn/shadow_log*.csv
live/fv/*.csv
live/fv/*.txt
live/fv/basis_report.json

# Backups / snapshots of any kind (the live originals ARE tracked; copies not)
*.bak
*.bak.*
*.bak_*

# NOTE: nn/checkpoints/*.pt and nn/data/*.npz are tracked ON PURPOSE
# (runtime model deps). Only their .bak_* copies are ignored above.

# ── Editors / OS ──────────────────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db

# ── Scratch / handoff notes ───────────────────────────────────────────────────
CONTEXT_HANDOFF.md
scratch/
scratchpad/

# Machine-local Claude Code settings
.claude/

# Pulled server data & recorded books (large, not source)
data/server_logs/
live/book_log.jsonl

# Sim outputs (regeneratable)
live/sim.*.out
